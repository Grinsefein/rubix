# Local configuration for Rubix Leaderboard.
# Copy this file to .env and adjust the values.

# Password for the moderation area at /admin
ADMIN_PASSWORD=rubix-admin

# Secret used to sign the admin cookie. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please-change-this-session-secret

# Salt used to hash reporter IP addresses (they are never stored in plain text).
REPORT_SALT=please-change-this-report-salt

# Number of reports from distinct IPs needed to auto-hide an entry.
REPORT_HIDE_THRESHOLD=3

# Optional: set to "true" when served over HTTPS so the admin cookie is marked Secure.
COOKIE_SECURE=false
